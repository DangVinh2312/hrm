# Copy to docker/.env.ops (Local Docker only: PostgreSQL container + offline CLI). Same password in each URL as its PRODUCT_*_PASSWORD.
# Never give this file to the API container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE
DATABASE_ADMIN_URL=postgres://postgres:REPLACE@postgres:5432/postgres
PRODUCT_DATABASE_NAME=hrm
PRODUCT_DATA_PASSWORD=REPLACE
PRODUCT_IDENTITY_PASSWORD=REPLACE
PRODUCT_AUTHORITY_PASSWORD=REPLACE
PRODUCT_SYNC_PASSWORD=REPLACE
PRODUCT_MIGRATION_PASSWORD=REPLACE
PRODUCT_BOOTSTRAP_PASSWORD=REPLACE
PRODUCT_OUTBOX_PASSWORD=REPLACE
PRODUCT_IDENTITY_DATABASE_URL=postgres://product_identity:REPLACE@postgres:5432/hrm
PRODUCT_SYNC_DATABASE_URL=postgres://product_sync:REPLACE@postgres:5432/hrm
PRODUCT_MIGRATION_DATABASE_URL=postgres://product_migration:REPLACE@postgres:5432/hrm
PRODUCT_BOOTSTRAP_DATABASE_URL=postgres://product_bootstrap:REPLACE@postgres:5432/hrm
