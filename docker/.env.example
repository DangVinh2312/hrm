# Copy to docker/.env.api (Local Docker only: API runtime). Passwords must match docker/.env.ops.
NODE_ENV=development
PORT=6868
TRUST_PROXY=0
LOG_LEVEL=info
# Browser origin = Vite dev server (same origin, /api proxied). Use localhost, not 127.0.0.1.
APP_ORIGIN=http://localhost:6368
PRODUCT_DATA_DATABASE_URL=postgres://product_data:REPLACE@postgres:5432/hrm
PRODUCT_IDENTITY_DATABASE_URL=postgres://product_identity:REPLACE@postgres:5432/hrm
PRODUCT_AUTHORITY_DATABASE_URL=postgres://product_authority:REPLACE@postgres:5432/hrm
PRODUCT_SYNC_DATABASE_URL=postgres://product_sync:REPLACE@postgres:5432/hrm
# Google OIDC: replace clientId/clientSecret with an OAuth client whose redirect URI is
# exactly http://localhost:6368/api/auth/oidc/callback. Boot only needs Google discovery to resolve.
OIDC_PROVIDERS_JSON=[{"issuer":"https://accounts.google.com","clientId":"REPLACE_WITH_GOOGLE_CLIENT_ID","clientSecret":"REPLACE_WITH_GOOGLE_CLIENT_SECRET","redirectUri":"http://localhost:6368/api/auth/oidc/callback","version":"1","assuranceMappings":[]}]
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"; keep it while stored TOTP secrets use k1.
MFA_ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
MFA_ENCRYPTION_KEY_ID=k1
