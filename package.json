{
  "name": "hrm",
  "version": "0.0.0",
  "private": true,
  "description": "HRM web application (NestJS API + React web)",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "12.3.4"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.json",
    "lint": "pnpm run build && eslint .",
    "test:unit": "pnpm run test:workspace && pnpm -r run test:unit",
    "test:integration": "pnpm -r run test:integration",
    "db:migrate": "pnpm --filter @hrm/api run db:migrate",
    "db:provision": "pnpm --filter @hrm/api run db:provision",
    "start:dev": "pnpm --filter @hrm/api run start:dev",
    "format": "eslint --config eslint.format.config.js --fix . && prettier --write .",
    "format:check": "eslint --config eslint.format.config.js . && prettier --check .",
    "format:code": "eslint --config eslint.format.config.js --fix . && prettier --write \"**/*.{ts,js}\"",
    "format:code:check": "eslint --config eslint.format.config.js . && prettier --check \"**/*.{ts,js}\"",
    "test:e2e": "pnpm -r run test:e2e",
    "test:browser": "pnpm -r run test:browser",
    "manifest:sync": "pnpm --filter @hrm/api run manifest:sync",
    "root:bootstrap": "pnpm --filter @hrm/api run root:bootstrap",
    "root:revoke": "pnpm --filter @hrm/api run root:revoke",
    "root:reissue": "pnpm --filter @hrm/api run root:reissue",
    "root:set-email": "pnpm --filter @hrm/api run root:set-email",
    "identity:enroll": "pnpm --filter @hrm/api run identity:enroll",
    "identity:invite": "pnpm --filter @hrm/api run identity:invite",
    "identity:purge-sessions": "pnpm --filter @hrm/api run identity:purge-sessions",
    "identity:reset-mfa": "pnpm --filter @hrm/api run identity:reset-mfa",
    "root:reset-mfa": "pnpm --filter @hrm/api run root:reset-mfa",
    "test:workspace": "node --test test/**/*.spec.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.9.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
