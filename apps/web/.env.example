# Public build-time settings: every VITE_ value ends up in the browser bundle. Never put secrets here.
VITE_OIDC_ISSUER=https://accounts.google.com
# Dev server only: where /api is proxied.
HRM_API_TARGET=http://127.0.0.1:6369
# Dev server port; must match APP_ORIGIN and the OIDC redirectUri of the API.
HRM_WEB_PORT=6368
