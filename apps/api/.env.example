# API only. Copy to .env.api, never include migration/bootstrap/admin credentials here.
NODE_ENV=development
PORT=3000
# Reverse-proxy hops in front of the API (0 = direct). Rate limits key on the resulting client IP.
TRUST_PROXY=0
LOG_LEVEL=warn
APP_ORIGIN=http://localhost:3000
PRODUCT_DATA_DATABASE_URL=postgres://product_data:REPLACE@127.0.0.1:55433/hrm
PRODUCT_IDENTITY_DATABASE_URL=postgres://product_identity:REPLACE@127.0.0.1:55433/hrm
PRODUCT_AUTHORITY_DATABASE_URL=postgres://product_authority:REPLACE@127.0.0.1:55433/hrm
PRODUCT_SYNC_DATABASE_URL=postgres://product_sync:REPLACE@127.0.0.1:55433/hrm
# Required: sign-in is Google OIDC only (ADR 0027). Fixed HTTPS callbacks; no email/group mapping.
OIDC_PROVIDERS_JSON=[{"issuer":"https://idp.example.test","clientId":"product","redirectUri":"https://app.example.test/api/auth/oidc/callback","version":"1","assuranceMappings":[]}]
# Second factor (ADR 0026 §3): AES-256-GCM keys for TOTP secrets, `<id>:<base64 of 32 random bytes>`
# separated by commas; MFA_ENCRYPTION_KEY_ID names the key new secrets use. Generate one with
# `node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"`.
# Keep old ids until no stored secret uses them (boot fails otherwise); back the keys up apart
# from the database. Never commit real keys.
MFA_ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
MFA_ENCRYPTION_KEY_ID=k1
